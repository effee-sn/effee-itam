generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

enum RoleScope {
  ALL
  DEPARTMENT
  SELF
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id           Int        @id @default(autoincrement())
  employeeId   String     @map("employee_id")
  name         String
  email        String
  phone        String?
  passwordHash String     @map("password_hash")
  roleId       Int        @map("role_id")
  departmentId Int        @map("department_id")
  designation  String?
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?    @map("avatar_url")
  lastLoginAt  DateTime?  @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  role       Role       @relation(fields: [roleId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  assetsCurrentlyHeld  Asset[]           @relation("AssetCurrentHolder")
  assignmentsReceived  AssetAssignment[] @relation("AssignmentToUser")
  assignmentsGivenUp   AssetAssignment[] @relation("AssignmentFromUser")
  assignmentsPerformed AssetAssignment[] @relation("AssignmentPerformedBy")
  auditLogs            AuditLog[]

  @@index([employeeId])
  @@index([email])
  @@map("users")
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users  User[]
  assets Asset[]

  @@index([name])
  @@map("departments")
}

model Vendor {
  id            Int       @id @default(autoincrement())
  name          String
  contactPerson String?   @map("contact_person")
  phone         String?
  email         String?
  address       String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  assetsSupplied Asset[]

  @@index([name])
  @@map("vendors")
}

// ---------------------------------------------------------------------------
// Assets
// ---------------------------------------------------------------------------

// Which shape of asset a record is — decides which detail table holds its type-specific
// fields, and which form/list/export layout it gets. Modelled on GLPI's "itemtype". Set
// directly by the form the asset was created on (there is one form per type), NOT derived
// from a category — asset categories were removed because maintaining a second, overlapping
// classification on top of this enum was confusing. Desktop/Laptop/Server are deliberately
// NOT separate types: they share every field, so they're all COMPUTER, separated by
// Computer.subType. OTHER is the catch-all for anything that fits no type.
enum AssetType {
  COMPUTER
  MONITOR
  PRINTER
  PHONE
  SIM_CARD
  NETWORK_DEVICE
  PERIPHERAL
  OTHER
}

model Asset {
  id                    Int         @id @default(autoincrement())
  assetTag              String      @unique @map("asset_tag")
  serialNumber          String?     @map("serial_number")
  hostname              String?     @map("hostname")
  macAddress            String?     @map("mac_address")
  ipAddress             String?     @map("ip_address")
  // The asset's shape. Set from whichever type-specific form created it and validated
  // server-side against the AssetType enum.
  assetType             AssetType   @default(OTHER) @map("asset_type")
  brand                 String?
  model                 String?
  vendorId              Int?        @map("vendor_id")
  purchaseDate          DateTime?   @map("purchase_date")
  invoiceNumber         String?     @map("invoice_number")
  warrantyStart         DateTime?   @map("warranty_start")
  warrantyEnd           DateTime?   @map("warranty_end")
  cost                  Decimal?    @db.Decimal(12, 2)
  departmentId          Int?        @map("department_id")
  currentAssignedUserId Int?        @map("current_assigned_user_id")
  status                AssetStatus @default(AVAILABLE)
  notes                 String?     @db.Text
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at")

  vendor              Vendor?       @relation(fields: [vendorId], references: [id])
  department          Department?   @relation(fields: [departmentId], references: [id])
  currentAssignedUser User?         @relation("AssetCurrentHolder", fields: [currentAssignedUserId], references: [id])

  images             AssetImage[]
  documents          AssetDocument[]
  assignments        AssetAssignment[] @relation("AssignmentAsset")
  relatedAssignments AssetAssignment[] @relation("AssignmentRelatedAsset")

  // Type-specific detail, one optional 1:1 row per asset. Exactly one of these is set,
  // decided by assetType (OTHER has none). Everything else in the app keeps pointing at
  // this base row, so none of the relations above are affected by the split.
  computer      Computer?
  monitor       Monitor?
  printer       Printer?
  phone         Phone?
  simCard       SimCard?
  networkDevice NetworkDevice?
  peripheral    Peripheral?

  // Devices attached to this asset (when it's a computer), and the computer this asset is
  // attached to (when it's a monitor/printer/peripheral).
  connectedDevices  AssetConnection[] @relation("AssetConnectionComputer")
  connectedToComputer AssetConnection? @relation("AssetConnectionDevice")

  @@index([serialNumber])
  @@index([macAddress])
  @@index([assetType])
  @@index([assetType, status])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Per-type asset detail (GLPI-style). Each row extends exactly one Asset with the
// fields that only make sense for that kind of hardware. Shared fields — asset tag,
// serial, hostname, MAC, IP, brand/model, status, department, holder, purchase and
// warranty — deliberately stay on Asset so every existing query, picker and relation
// keeps working untouched.
// ---------------------------------------------------------------------------

model Computer {
  id      Int @id @default(autoincrement())
  assetId Int @unique @map("asset_id")

  // Desktop / Laptop / Server. This is what the old admin-managed AssetCategory used to
  // express; it's a fixed list on the type itself now, so there's no category table to keep
  // in step with the code that branches on it.
  subType String? @map("sub_type")

  // Operating system, broken out the way GLPI does rather than one free-text box — so you
  // can actually answer "which machines are still on 22H2" or "which are 32-bit".
  osName          String?   @map("os_name")
  osVersion       String?   @map("os_version")
  osArchitecture  String?   @map("os_architecture")
  osServicePack   String?   @map("os_service_pack")
  osKernelVersion String?   @map("os_kernel_version")
  osProductKey    String?   @map("os_product_key")
  osInstallDate   DateTime? @map("os_install_date")

  // Network / domain identity
  localDomain    String? @map("local_domain")
  workgroup      String?
  intuneEnrolled Boolean @default(false) @map("intune_enrolled")

  // Machine identity. UUID is what inventory agents key on, so it's the reliable identifier
  // when hostnames and serials get re-used or mistyped.
  uuid        String? @map("uuid")
  biosVersion String? @map("bios_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset      Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  components ComputerComponent[]

  @@index([uuid])
  @@map("computers")
}

// GLPI models components as repeatable items because real machines have more than one of
// most things — a server with 2 CPUs and 8 RAM modules can't be described by single fields.
enum ComponentType {
  PROCESSOR
  MEMORY
  STORAGE
  GRAPHICS
  NETWORK_CARD
  MOTHERBOARD
  POWER_SUPPLY
  SOUND_CARD
  CASE
  BATTERY
  OTHER
}

model ComputerComponent {
  id            Int           @id @default(autoincrement())
  computerId    Int           @map("computer_id")
  type          ComponentType
  name          String
  // Free-form so it fits any component: "10 cores @ 4.8GHz", "DDR5-4800", "NVMe Gen4".
  specification String?
  capacity      String?
  serialNumber  String?       @map("serial_number")
  quantity      Int           @default(1)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  computer Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@index([computerId, type])
  @@map("computer_components")
}

// A device physically attached to a computer — GLPI's computers_items. Lets a laptop's page
// show its dock and two monitors, and stops those peripherals looking unassigned.
model AssetConnection {
  id      Int      @id @default(autoincrement())
  // The computer side of the link.
  computerAssetId Int @map("computer_asset_id")
  // The attached device. Unique: a monitor can only be plugged into one computer at a time,
  // which is also what makes "is this free?" answerable.
  connectedAssetId Int @unique @map("connected_asset_id")
  connectedAt DateTime @default(now()) @map("connected_at")
  notes       String?

  computerAsset  Asset @relation("AssetConnectionComputer", fields: [computerAssetId], references: [id], onDelete: Cascade)
  connectedAsset Asset @relation("AssetConnectionDevice", fields: [connectedAssetId], references: [id], onDelete: Cascade)

  @@index([computerAssetId])
  @@map("asset_connections")
}

enum DiscoveredStatus {
  PENDING // waiting for an admin to review + onboard
  ONBOARDED // an asset was created from it
  DISMISSED // admin chose to ignore it
}

enum DiscoveredDeviceType {
  COMPUTER
  MONITOR
}

// Something the inventory agent reported that DOESN'T match any existing asset yet — either the
// machine itself, or an external monitor plugged into it. It is NOT an asset: assets need a
// human-assigned tag (see the manual-asset-tag decision), so it waits here until an admin
// onboards it with a real tag, at which point everything the agent collected is used to build
// the asset. Re-running the agent updates the same row (lastSeen + payload) rather than piling
// up duplicates; matching is by uuid then serial, done in code (both can be blank or duplicated
// on cheap hardware, so neither is a safe DB unique key).
model DiscoveredDevice {
  id           Int                  @id @default(autoincrement())
  deviceType   DiscoveredDeviceType @default(COMPUTER) @map("device_type")
  uuid         String?              @map("uuid")
  serialNumber String?              @map("serial_number")
  hostname     String?
  manufacturer String?
  model        String?
  osName       String?              @map("os_name")

  // For a MONITOR: the computer asset it was found plugged into, so onboarding can connect it
  // straight away. Null for computers (and for a monitor seen on a machine we don't know yet).
  seenOnAssetId Int? @map("seen_on_asset_id")

  // What the agent collected, kept verbatim so onboarding can build the asset (base fields, OS
  // detail, hardware components / display size) without the agent having to send it again.
  payload Json

  status           DiscoveredStatus @default(PENDING)
  onboardedAssetId Int?             @map("onboarded_asset_id")
  firstSeen        DateTime         @default(now()) @map("first_seen")
  lastSeen         DateTime         @default(now()) @map("last_seen")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([deviceType, status])
  @@map("discovered_devices")
}

model Monitor {
  id      Int @id @default(autoincrement())
  assetId Int @unique @map("asset_id")

  // The vendor's own model/part identifier off the sticker on the back (Lenovo calls it the MTM).
  // Manual: EDID carries no such field, so the inventory agent can never fill this in.
  partNumber String? @map("part_number")

  // Display panel
  sizeInches    Decimal? @map("size_inches") @db.Decimal(4, 1)
  resolution    String?
  panelType     String?  @map("panel_type")
  refreshRateHz Int?     @map("refresh_rate_hz")

  // Video inputs. GLPI models each port as its own flag rather than one free-text list,
  // which is what makes "which monitors can take DisplayPort" an answerable question when
  // you're working out what will actually plug into a given machine.
  hasVga         Boolean @default(false) @map("has_vga")
  hasDvi         Boolean @default(false) @map("has_dvi")
  hasHdmi        Boolean @default(false) @map("has_hdmi")
  hasDisplayPort Boolean @default(false) @map("has_display_port")
  hasUsbC        Boolean @default(false) @map("has_usb_c")

  // Built-in extras — the things people raise tickets about ("my monitor's webcam died").
  hasUsbHub     Boolean @default(false) @map("has_usb_hub")
  hasSpeakers   Boolean @default(false) @map("has_speakers")
  hasMicrophone Boolean @default(false) @map("has_microphone")
  hasWebcam     Boolean @default(false) @map("has_webcam")

  // Stand and mounting — what decides whether it can be rotated or wall-mounted.
  hasPivot         Boolean @default(false) @map("has_pivot")
  heightAdjustable Boolean @default(false) @map("height_adjustable")
  vesaMount        String? @map("vesa_mount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("monitors")
}

model Printer {
  id             Int      @id @default(autoincrement())
  assetId        Int      @unique @map("asset_id")
  printerType    String?  @map("printer_type")
  connectionType String?  @map("connection_type")
  pageCount      Int?     @map("page_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("printers")
}

model Phone {
  id          Int      @id @default(autoincrement())
  assetId     Int      @unique @map("asset_id")
  imei        String?
  os          String?
  phoneNumber String?  @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([imei])
  @@map("phones")
}

model SimCard {
  id           Int      @id @default(autoincrement())
  assetId      Int      @unique @map("asset_id")
  mobileNumber String?  @map("mobile_number")
  iccid        String?
  planName     String?  @map("plan_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([mobileNumber])
  @@map("sim_cards")
}

model NetworkDevice {
  id              Int      @id @default(autoincrement())
  assetId         Int      @unique @map("asset_id")
  deviceType      String?  @map("device_type")
  portCount       Int?     @map("port_count")
  firmwareVersion String?  @map("firmware_version")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("network_devices")
}

model Peripheral {
  id             Int      @id @default(autoincrement())
  assetId        Int      @unique @map("asset_id")
  peripheralType String?  @map("peripheral_type")
  interface      String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("peripherals")
}

model AssetImage {
  id        Int      @id @default(autoincrement())
  assetId   Int      @map("asset_id")
  filePath  String   @map("file_path")
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_images")
}

model AssetDocument {
  id        Int      @id @default(autoincrement())
  assetId   Int      @map("asset_id")
  filePath  String   @map("file_path")
  label     String?
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_documents")
}

// ---------------------------------------------------------------------------
// Assignment / History (asset_assignments is the single source of truth for
// both "Assign/Return/Transfer" actions and the Asset History view — never
// delete rows here, only append)
// ---------------------------------------------------------------------------

model AssetAssignment {
  id                Int              @id @default(autoincrement())
  assetId           Int              @map("asset_id")
  action            AssignmentAction
  fromUserId        Int?             @map("from_user_id")
  toUserId          Int?             @map("to_user_id")
  performedByUserId Int              @map("performed_by_user_id")
  relatedAssetId    Int?             @map("related_asset_id")
  actionDate        DateTime         @default(now()) @map("action_date")
  notes             String?          @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")

  asset        Asset  @relation("AssignmentAsset", fields: [assetId], references: [id])
  relatedAsset Asset? @relation("AssignmentRelatedAsset", fields: [relatedAssetId], references: [id])
  fromUser     User?  @relation("AssignmentFromUser", fields: [fromUserId], references: [id])
  toUser       User?  @relation("AssignmentToUser", fields: [toUserId], references: [id])
  performedBy  User   @relation("AssignmentPerformedBy", fields: [performedByUserId], references: [id])

  @@index([assetId, actionDate])
  @@map("asset_assignments")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          Int         @id @default(autoincrement())
  userId      Int?        @map("user_id")
  action      AuditAction
  module      String
  entityType  String?     @map("entity_type")
  entityId    Int?        @map("entity_id")
  description String?     @db.Text
  ipAddress   String?     @map("ip_address")
  createdAt   DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Settings (single row, id fixed at 1)
// ---------------------------------------------------------------------------

model Settings {
  id          Int      @id @default(1)
  companyName String   @default("Company Name") @map("company_name")
  logoPath    String?  @map("logo_path")
  address     String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  RETIRED
  LOST
}

enum AssignmentAction {
  ASSIGN
  RETURN
  TRANSFER
  REPLACEMENT
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ASSIGN
  RETURN
  PERMISSION_CHANGE
}
