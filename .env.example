# Copy this file to .env and fill in real values. .env is gitignored.

# MySQL connection string. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/itam"

# Secret used to sign JWT session tokens. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# Session token lifetime.
JWT_EXPIRES_IN="1d"

# Set to "true" only once this app is actually served over HTTPS (e.g. behind nginx +
# certbot). Marks the session cookie as Secure, which browsers silently refuse to store
# over plain HTTP — leaving this "true" without real HTTPS in front makes login appear to
# succeed but never actually persist. Leave unset/"false" for local dev and HTTP-only
# internal deployments.
COOKIE_SECURE="false"

# Optional shared secret for the PowerShell inventory agent (scripts/inventory-agent.ps1).
# If set, agents must send a matching `X-Inventory-Token` header to POST /api/inventory;
# leave it unset/empty to accept reports openly on a trusted internal network. Rotate by
# changing this value and the -Token in the script, then restarting the app.
INVENTORY_TOKEN=""
